# By default, all files should have LF newlines. This ensures that they
# will continue to function if they are copied into a Linux container
# (as with our launch and shell test scripts)
* text eol=lf

# Windows batch files (namely gradlew.bat) are committed with CRLF, exactly as
# Gradle ships them and as Dependabot wrapper bumps write them. Leave them
# untouched: with eol=crlf git expected LF in the repository, so every
# checkout showed gradlew.bat modified and blocked rebases.
*.bat -text

# Binary files that should not be modified
server/zfs/kernel/* binary
server/zfs/userland/** binary
*.jar binary
*.gz binary
*.png binary
